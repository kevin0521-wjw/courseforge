{
  "name": "courseforge",
  "version": "0.3.0",
  "description": "课表工坊 CourseForge - 大学生课程表平台（网页版 + Electron 桌面端 + Android）",
  "scripts": {
    "test": "node --test",
    "check:dom": "node tools/check-dom.mjs",
    "check:mutation": "node tools/mutation-check.mjs",
    "check:browser": "node tools/browser-selftest.mjs",
    "check:webui": "node tools/webui-selftest.mjs",
    "check:import-web": "node tools/import-web-selftest.mjs",
    "check:import-edu": "node tools/import-edu-selftest.mjs",
    "check:share": "node tools/share-image-selftest.mjs",
    "check:desktop": "node tools/desktop-selftest.mjs",
    "check:package": "node tools/verify-package.mjs",
    "verify": "node --test && node tools/check-dom.mjs && node tools/mutation-check.mjs && node tools/build-standalone.mjs && node tools/verify-package.mjs",
    "build:standalone": "node tools/build-standalone.mjs",
    "icons": "python tools/make-icons.py",
    "icons:check": "python tools/make-icons.py --check",
    "pack:desktop": "cd desktop && npm run pack",
    "dist:desktop": "cd desktop && npm run dist",
    "start:web": "node tools/serve.mjs",
    "tunnel": "node tools/tunnel.mjs",
    "cap:sync": "npx cap sync android",
    "android:icons": "python tools/make-android-icons.py"
  },
  "keywords": [
    "timetable",
    "course-schedule",
    "electron",
    "零依赖"
  ],
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "jsdom": "^30.0.0",
    "pdfjs-dist": "3.11.174"
  }
}
